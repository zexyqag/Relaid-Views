{
  "theme": {
    "accent": "#0060e6",
    "light": {
      "background": "#ffffff",
      "surface": "#ffffff",
      "text": "#333333",
      "muted": "#687484",
      "onAccent": "#ffffff"
    },
    "dark": {
      "accent": "#9ac4ff",
      "background": "#001c44",
      "surface": "#001c44",
      "text": "#ffffff",
      "muted": "#adb5bd",
      "onAccent": "#001c44"
    },
    "corners": "square",
    "header": "plain",
    "cards": "outlined"
  },
  "screens": [
    {
      "name": "mitid-pin",
      "displayName": "PIN entry",
      "when": [
        "desc~:digits entered"
      ],
      "secure": true,
      "parts": [
        {
          "select": "desc~:digits entered",
          "as": "pin",
          "label": "PIN"
        }
      ]
    },
    {
      "name": "mitid-screens",
      "displayName": "All other screens",
      "secure": true,
      "priority": -1,
      "parts": [
        {
          "select": "class:android.view.View & is:clickable & has(class:android.view.View & is:clickable) & has(class:android.widget.Button)",
          "as": "action",
          "confirm": "slide"
        },
        {
          "select": "class:android.view.View & desc:Godkend & not(is:clickable) & has(class:android.view.View & is:clickable)",
          "as": "action",
          "perform": "swipe-right"
        },
        {
          "select": "class:android.view.View & desc:Approve & not(is:clickable) & has(class:android.view.View & is:clickable)",
          "as": "action",
          "perform": "swipe-right"
        }
      ]
    }
  ]
}

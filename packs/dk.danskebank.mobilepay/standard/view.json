{
  "theme": {
    "accent": "#5a78ff",
    "light": {
      "background": "#ffffff",
      "surface": "#f9f6f6",
      "text": "#000000",
      "muted": "#666666",
      "onAccent": "#ffffff"
    },
    "dark": {
      "accent": "#5a78ff",
      "background": "#00051f",
      "surface": "#161b31",
      "text": "#ffffff",
      "muted": "#96a3e1",
      "onAccent": "#ffffff"
    },
    "corners": "round",
    "header": "plain",
    "cards": "filled"
  },
  "screens": [
    {
      "name": "mobilepay-home",
      "displayName": "Home",
      "when": [
        "id:TAG_ACTION_BUTTON_SEND"
      ],
      "parts": [
        {
          "select": "id:TAG_ACTION_BUTTON_SEND",
          "as": "action",
          "label": "Send",
          "tone": "primary"
        },
        {
          "select": "id:TAG_ACTION_BUTTON_REQUEST",
          "as": "action",
          "label": "Request",
          "tone": "secondary"
        },
        {
          "select": "id:TAG_ACTION_BUTTON_QR",
          "as": "option",
          "label": "QR",
          "tone": "muted"
        },
        {
          "select": "id:TAG_BOTTOM_NAV_ITEM_HOME",
          "as": "tab",
          "label": "Home",
          "icon": "home"
        },
        {
          "select": "id:TAG_BOTTOM_NAV_ITEM_PAYMENTS",
          "as": "tab",
          "label": "Payments",
          "icon": "list"
        },
        {
          "select": "id:TAG_BOTTOM_NAV_ITEM_SOCIAL",
          "as": "tab",
          "label": "Groups",
          "icon": "people"
        },
        {
          "select": "id:TAG_BOTTOM_NAV_ITEM_WALLET",
          "as": "tab",
          "label": "Wallet",
          "icon": "wallet"
        },
        {
          "select": "id:TAG_RECENT_CONVERSATION_TILE",
          "as": "person"
        }
      ]
    },
    {
      "name": "mobilepay-pin",
      "displayName": "PIN lock",
      "when": [
        "desc:Pincode field"
      ],
      "secure": true,
      "parts": [
        {
          "select": "desc:Pincode field",
          "as": "pin",
          "total": 4
        }
      ]
    },
    {
      "name": "mobilepay-send",
      "displayName": "Choose recipient",
      "when": [
        "id:TAG_UNIFIED_SEARCH_INPUT_FIELD"
      ],
      "parts": [
        {
          "select": "id:TAG_UNIFIED_SEARCH_INPUT_FIELD",
          "as": "field",
          "label": "Search name or number"
        },
        {
          "select": "id:TAG_SUGGESTION_PERSON",
          "as": "person"
        }
      ]
    },
    {
      "name": "mobilepay-amount",
      "displayName": "Amount",
      "when": [
        "id:TAG_ADD_PAYMENT_DETAILS_SCREEN_AMOUNT"
      ],
      "parts": [
        {
          "select": "text:+",
          "as": "hidden"
        },
        {
          "select": "text:−",
          "as": "hidden"
        },
        {
          "select": "text:×",
          "as": "hidden"
        },
        {
          "select": "text:÷",
          "as": "hidden"
        },
        {
          "select": "text:=",
          "as": "hidden"
        },
        {
          "select": "text:Back",
          "as": "hidden"
        },
        {
          "select": "text:Send to",
          "as": "hidden"
        },
        {
          "select": "id:TAG_ADD_PAYMENT_DETAILS_SCREEN_AMOUNT",
          "as": "hero"
        },
        {
          "select": "id:TAG_ADD_PAYMENT_DETAILS_SCREEN_NEXT_BUTTON",
          "as": "action",
          "label": "Next",
          "tone": "primary"
        },
        {
          "select": "id:TAG_ADD_PAYMENT_DETAILS_SCREEN_AMOUNT",
          "as": "field",
          "label": "Amount (kr)",
          "keyboard": "number"
        },
        {
          "select": "id:TAG_ADD_MESSAGE_FIELD",
          "as": "field",
          "label": "Message (optional)"
        }
      ]
    },
    {
      "name": "mobilepay-confirm",
      "displayName": "Confirm and send",
      "when": [
        "id:TAG_SWIPER_SURFACE"
      ],
      "parts": [
        {
          "select": "id:TAG_AMOUNT_SUMMARY",
          "as": "title"
        },
        {
          "select": "id:TAG_AMOUNT_SUMMARY",
          "as": "hero"
        },
        {
          "select": "id:TAG_SWIPER_SURFACE",
          "as": "action",
          "tone": "primary",
          "confirm": "slide"
        }
      ]
    }
  ]
}

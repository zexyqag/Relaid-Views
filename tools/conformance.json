{
  "about": "Pack rule cases with the expected verdict of the phone (Relaid's validator) and of tools/check.py, and, where given, the theme parts the phone ignores. Each case is one view file. Both run these.",
  "cases": [
    {
      "why": "a minimal pack",
      "app": "com.example.app",
      "pack": {
        "screens": [
          {
            "name": "x"
          }
        ]
      },
      "phone": true,
      "check": true
    },
    {
      "why": "a full pack using every role and option",
      "app": "com.example.app",
      "pack": {
        "theme": {
          "accent": "#1a73e8"
        },
        "screens": [
          {
            "name": "send",
            "displayName": "Choose recipient",
            "when": [
              "id:recipient_list",
              "text~:send to"
            ],
            "activity": "SendActivity",
            "secure": false,
            "priority": 1,
            "parts": [
              {
                "select": "id:toolbar_title",
                "as": "title"
              },
              {
                "select": "id:promo_banner",
                "as": "hidden"
              },
              {
                "select": "class:RecyclerView",
                "as": "list",
                "scroll": "drag"
              },
              {
                "select": "id:msg",
                "as": "text"
              },
              {
                "select": "id:sender",
                "as": "heading"
              },
              {
                "select": "id:photo",
                "as": "picture",
                "label": "Photo"
              },
              {
                "select": "id:icon",
                "label": "Icon"
              },
              {
                "select": "id:amount",
                "as": "hero"
              },
              {
                "select": "id:search",
                "as": "field",
                "label": "Search",
                "keyboard": "text"
              },
              {
                "select": "id:send",
                "as": "action",
                "label": "Send",
                "tone": "primary",
                "confirm": "slide",
                "perform": "click"
              },
              {
                "select": "id:more",
                "as": "option",
                "label": "More",
                "tone": "muted"
              },
              {
                "select": "id:home_tab",
                "as": "tab",
                "label": "Home",
                "icon": "home"
              },
              {
                "select": "id:contact",
                "as": "person"
              },
              {
                "select": "id:chat_row",
                "as": "row",
                "parts": "class:Label",
                "press": "id:open"
              },
              {
                "select": "id:pin_dots",
                "as": "pin",
                "label": "PIN",
                "total": 4
              }
            ]
          }
        ]
      },
      "phone": true,
      "check": true
    },
